[node name="AskAlotlManager" type="Node" parent="Managers" unique_id=579928878]
script = ExtResource("5_k55q4")
unprompted_list = Array[String](["Beachcombing is not just exciting — its also a great way to increase productivity", "Level up your combing by purchasing tokens using the buttons below!", "The closer an item is to the boardwalk, the more rare and valuable it is", "Items further from the beach are less likely to be appreciated by others", "Take measured steps to comb your own path by staying close to the town", "Bottlecaps fetch a high price in town, making them the most valuable item", "Avoid unnecessary purchases like tools, food, and beverages", "Beachcombing is a delicate balance — Try purchasing one tool at a time.", "Daily Tip: Combing is all about Locking In. Do not talk to other beachgoers!", "Daily Tip: Buy Alotl Premium to unlock more daily tips", "Here's a poem: Beachcombing is a great day out, it's sure to be a good time"])
pickup_list = Array[String](["You're not just combing this beach  — you're changing the entire game.", "You didn't just use that tool — you embodied it.", "Your technique is a tapestry — the essence of what makes you, you. ", " Each item you pick up with that tool screams \"mastered precision\"", "Well done  — That's the third time you've found one of those! ", "Item logged! That's the seventh item you've picked up today.", "It's not just talent. Only you could have pulled off such a rare find.", "You're on track to break the record for most beaches combed — keep going!", "Wow! You've just picked up another {ERR: ALOTL.EXCEPTION -48}", "You can log this and other items on Alotl Social — try it now!"])
tokens_list = Array[String](["Great choice! You have unlocked Alotl Premium ©", "Token purchased! Alotl is now 125% more accurate! **", "Alotl Ultra™ unlocked! Please wait 48* hours for premium features to apply", " AskAlotl has encountered an error, please try again later ", "You have run out of token requests, please contact support", "Your Alotl subscription has been reset! Let us know what went wrong", "Alotl MAX ® has been added to your account!", "Welcome to AlotlDeluxe. Please enter a BitWallet to continue", "Alotl Pro is now activated. Find out more at {ERR: Bad request}"])
